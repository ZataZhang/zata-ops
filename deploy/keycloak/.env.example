# =============================================================================
# Keycloak 环境变量模板（compose.yaml 与 compose.dokploy.yaml 共用）
# =============================================================================
# 普通 VPS：复制为 .env 并 chmod 600；Dokploy：填入 Compose 应用的 Environment 面板。
# 不要提交真实值。生成命令见 README.md 的 Credentials 一节。

# 公网主机名，只填主机名，不含协议和路径；DNS 须解析到部署机。
KC_PUBLIC_HOST=auth.example.com

# 业务 realm 名（必填），例如组织简称；出现在所有应用的 issuer 与登录地址里，部署后不要再改。
# Traefik 只放行 /realms/<KC_REALM>/。
KC_REALM=

# 登录页显示的名称；留空时与 KC_REALM 相同。只在首次导入 realm 时生效，之后到管理后台改。
# KC_REALM_DISPLAY_NAME=

# OTP HMAC key: generate with `openssl rand -hex 32`; keep the same value across restarts.
KC_SHARED_OTP_HMAC_SECRET=

# Alibaba Cloud SMS verification-code service (only required for SMS sign-in).
KC_OTP_SMS_ACCESS_KEY_ID=
KC_OTP_SMS_ACCESS_KEY_SECRET=
# KC_OTP_SMS_SIGN_NAME=
# KC_OTP_SMS_TEMPLATE_CODE=
# KC_OTP_SMS_ENDPOINT=dypnsapi.aliyuncs.com
# KC_OTP_SMS_PROTOCOL=https

# SMTP is required for email sign-in codes and Keycloak email verification/reset flows.
# KC_SMTP_HOST=
# KC_SMTP_PORT=587
# KC_SMTP_FROM=noreply@example.com
# KC_SMTP_FROM_DISPLAY_NAME=Shared Sign-In
# KC_SMTP_REPLY_TO=support@example.com
# KC_SMTP_AUTH=true
# KC_SMTP_SSL=false
# KC_SMTP_STARTTLS=true
# KC_SMTP_FROM_DISPLAY_NAME=
# KC_SMTP_REPLY_TO=
# KC_SMTP_USER=
KC_SMTP_PASSWORD=

# 镜像版本；升级前先读 Keycloak 升级说明并备份数据库。
KC_VERSION=26.8.2
KC_POSTGRES_VERSION=17.11

# 数据库密码（Keycloak 与 Postgres 共用）。
KC_DB_PASSWORD=

# 临时管理员，只用于首次登录 master realm；建好正式管理员后删除该账号。
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# 回环端口：管理后台（SSH 隧道访问）与 Postgres（备份用）。
KC_ADMIN_LOCAL_PORT=18180
KC_DB_LOCAL_PORT=15432

# 数据卷名；换名即得到空库，旧卷保留不动。
KC_DB_VOLUME=zata-ops-keycloak-db-data
