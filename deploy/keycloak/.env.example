# =============================================================================
# Keycloak 环境变量模板（compose.yaml 与 compose.dokploy.yaml 共用）
# =============================================================================
# 普通 VPS：复制为 .env 并 chmod 600；Dokploy：填入 Compose 应用的 Environment 面板。
# 不要提交真实值。生成命令见 README.md 的 Credentials 一节。

# 公网主机名，只填主机名，不含协议和路径；DNS 须解析到部署机。
KC_PUBLIC_HOST=auth.example.com

# 业务 realm 名；Traefik 只放行 /realms/<KC_REALM>/。
KC_REALM=zata

# 镜像版本；升级前先读 Keycloak 升级说明并备份数据库。
KC_VERSION=26.8.2
KC_POSTGRES_VERSION=17.11

# 数据库密码（Keycloak 与 Postgres 共用）。
KC_DB_PASSWORD=

# 临时管理员，只用于首次登录 master realm；建好正式管理员后删除该账号。
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# 回环端口：管理后台（SSH 隧道访问）与 Postgres（备份用）。
KC_ADMIN_LOCAL_PORT=18180
KC_DB_LOCAL_PORT=15432

# 数据卷名；换名即得到空库，旧卷保留不动。
KC_DB_VOLUME=zata-ops-keycloak-db-data

# freshai-dev 测试客户端：密钥与唯一允许的回调地址（只在首次导入 realm 时生效）。
KC_FRESHAI_DEV_CLIENT_SECRET=
KC_FRESHAI_DEV_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
