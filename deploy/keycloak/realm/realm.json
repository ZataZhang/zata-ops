{
  "realm": "${KC_REALM}",
  "displayName": "${KC_REALM_DISPLAY_NAME}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginTheme": "shared",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "browserFlow": "shared-browser",
  "authenticationFlows": [
    {
      "alias": "shared-browser",
      "description": "Shared password, email code, and SMS code browser login",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "shared-otp-authenticator",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "shared-registration-disabled",
      "description": "Self-registration happens through the shared code sign-in",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "teams",
      "subGroups": [
        {
          "name": "platform"
        }
      ]
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "zh-CN",
    "en"
  ],
  "defaultLocale": "zh-CN",
  "registrationFlow": "shared-registration-disabled"
}
