http:
  routers:
    openbao-api:
      entryPoints:
        - websecure
      rule: "Host(`@DOMAIN@`) && PathPrefix(`/v1/`)"
      middlewares:
        - openbao-source-allowlist
      service: openbao-api
      tls:
        certResolver: letsencrypt

  middlewares:
    openbao-source-allowlist:
      ipAllowList:
        sourceRange:
@SOURCE_RANGE_ENTRIES@

  services:
    openbao-api:
      loadBalancer:
        serversTransport: openbao-tls
        servers:
          - url: "https://@INGRESS_GATEWAY@:18200"

  serversTransports:
    openbao-tls:
      serverName: localhost
      rootCAs:
        - /etc/traefik/dynamic/openbao-upstream.crt
